{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/documents.js": { "maxDuration": 30 }, "api/workspace.js": { "maxDuration": 30 }, "api/port-calls.js": { "maxDuration": 30 }, "api/eta-import.js": { "maxDuration": 30 }, "api/eta-paste.js": { "maxDuration": 30 }, "api/hpbot-jstt.js": { "maxDuration": 60 } },
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "same-origin" }] },
    { "source": "/((?!pilot-bot(?:/|$)).*)", "headers": [{ "key": "X-Frame-Options", "value": "SAMEORIGIN" }] },
    { "source": "/pilot-bot/(.*)", "headers": [{ "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org https://t.me" }, { "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
